---
# Declare the language configuration is for
Language: Cpp

# Base the formatting on the industry-standard LLVM profile
BasedOnStyle: LLVM

# Use the latest language standards (C++20, C++23) to avoid parsing glitches
Standard: c++17

# --- INDENTATION & SPACING ---
# 4 spaces is universally readable for most developers
IndentWidth: 4
TabWidth: 4
UseTab: Never

# Do not indent code blocks inside namespaces
NamespaceIndentation: None

# Indent 'public:' and 'private:' keywords by 2 spaces instead of flushing left
AccessModifierOffset: -2

# --- LINE LIMITS ---
# 100 characters fits perfectly on modern monitors without wrapping too early
ColumnLimit: 100

# --- BRACE & WRAPPING RULES ---
# Attach braces to control statements, functions, and classes (Attach/K&R style)
BreakBeforeBraces: Attach

# Clean up short blocks so they don't awkwardly squish into one line
AllowShortBlocksOnASingleLine: Never
AllowShortFunctionsOnASingleLine: Inline
AllowShortIfStatementsOnASingleLine: Never
AllowShortLoopsOnASingleLine: false

# --- ALIGNMENT ---
# Pack parameters cleanly if they cross multiple lines
AlignAfterOpenBracket: Align
AlignOperands: Align
AlignTrailingComments: true

# Bind pointers to the type (int* ptr) rather than the variable (int *ptr)
PointerAlignment: Left

# --- INCLUDES ---
# Completely disable sorting, grouping, or modifying include directives
SortIncludes: Never
...
