{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build: selected target",
            "detail": "Builds target for active preset",
            "type": "cmake",
            "command": "build",
            "targets": [
                "${command:cmake.getLaunchTargetName}"
            ],
            "preset": "${command:cmake.activeBuildPresetName}",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc",
                "$msCompile"
            ]
        },
        {
            "label": "Build: all targets",
            "detail": "Builds all targets for active preset",
            "type": "cmake",
            "command": "build",
            "targets": [
                "all"
            ],
            "preset": "${command:cmake.activeBuildPresetName}",
            "problemMatcher": [
                "$gcc",
                "$msCompile"
            ]
        },
        {
            "label": "Format: check",
            "detail": "Uses format.sh to check for unformatted files",
            "type": "shell",
            "command": "bash",
            "args": [
                "scripts/format.sh",
                "--check"
            ],
            "problemMatcher": []
        },
        {
            "label": "Format: fix",
            "detail": "Uses format.sh to format all unformatted files",
            "type": "shell",
            "command": "bash",
            "args": [
                "scripts/format.sh"
            ],
            "problemMatcher": []
        },
        {
            "label": "Test: all",
            "type": "cmake",
            "command": "test",
            "preset": "${command:cmake.activeTestPresetName}",
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "problemMatcher": []
        },
        {
            "label": "Pre-PR",
            "detail": "Format check, build all, run all tests",
            "dependsOn": [
                "Format: check",
                "Build: all targets",
                "Test: all"
            ],
            "dependsOrder": "sequence",
            "problemMatcher": []
        }
    ]
}
